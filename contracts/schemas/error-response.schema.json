{
  "$defs": {
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "VALIDATION_ERROR",
            "FILE_TOO_LARGE",
            "UNSUPPORTED_MEDIA_TYPE",
            "ASSISTANT_UNAVAILABLE",
            "UPSTREAM_ERROR",
            "UPSTREAM_TIMEOUT"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "details": {
          "items": {
            "$ref": "#/$defs/FieldIssue"
          },
          "title": "Details",
          "type": "array"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "retry_after_seconds": {
          "anyOf": [
            {
              "maximum": 86400,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After Seconds"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "FieldIssue": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "field",
        "message"
      ],
      "title": "FieldIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "error": {
      "$ref": "#/$defs/ErrorDetail"
    }
  },
  "required": [
    "error"
  ],
  "title": "ErrorResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
