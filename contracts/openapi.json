            "type": "string",
            "enum": [
              "calculated",
              "reference_example"
            ],
            "title": "Data Source"
          },
          "input": {
            "$ref": "#/components/schemas/AnalysisRequest"
          },
          "normalized": {
            "$ref": "#/components/schemas/NormalizedInput"
          },
          "candidates": {
