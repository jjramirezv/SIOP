                "type": "null"
              }
            ],
            "title": "Current Order Quantity"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "product_name",
          "currency",
          "demand",
          "order_cost",
          "holding_cost",
          "days_per_year",
          "discount_tiers"
        ],
        "title": "AnalysisRequest"
