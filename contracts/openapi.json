                      },
                      "reason": "Se comparan las cantidades enteras vecinas y los límites factibles del tramo.",
                      "order": {
                        "tier_index": 0,
                        "quantity": 196,
                        "unit_price": 20.0,
                        "annual_holding_per_unit": 5.0,
                        "investment_per_order": 3920.0,
                        "orders_per_year": 12.244897959183673,
                        "cycle_days": 29.4,
                        "annual_costs": {
                          "purchase": 48000.0,
                          "ordering": 489.7959183673469,
                          "holding": 490.0,
                          "total": 48979.795918367345
                        }
                      }
                    },
                    {
                      "tier_index": 1,
                      "min_quantity": 200,
                      "max_quantity_exclusive": 500,
                      "unit_price": 19.6,
                      "annual_holding_per_unit": 5.0,
                      "theoretical_eoq": 195.95917942265424,
                      "status": "adjusted",
                      "evaluated_quantity": 200,
                      "annual_costs": {
                        "purchase": 47040.0,
                        "ordering": 480.0,
                        "holding": 500.0,
                        "total": 48020.0
                      },
                      "reason": "Se ajusta al mínimo del descuento.",
                      "order": {
                        "tier_index": 1,
                        "quantity": 200,
                        "unit_price": 19.6,
                        "annual_holding_per_unit": 5.0,
                        "investment_per_order": 3920.0,
                        "orders_per_year": 12.0,
                        "cycle_days": 30.0,
                        "annual_costs": {
                          "purchase": 47040.0,
                          "ordering": 480.0,
                          "holding": 500.0,
                          "total": 48020.0
